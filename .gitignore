# ---- Secrets / credentials (NEVER commit) ----
.env
.env.*
!.env.example
*.pem
*.key
**/credentials.json
**/kaggle.json

# ---- Data (large, re-downloadable) ----
data/raw/
*.sqlite
*.db
# WAL sidecars — not matched by *.db, present while the queue is open
*.db-wal
*.db-shm
# Exception: the demo snapshot IS committed. It is the only way the hosted
# dashboard has data — a free tier can neither run the pipeline nor keep a
# filesystem across redeploys. Small (tens of KB), real briefs, provenance in
# results/demo_seed_provenance.json. Generated by scripts/seed_demo_db.py.
!data/demo_review_queue.db

# ---- Trained model artifacts ----
# Ignore the directory's CONTENTS rather than the directory: git will not look
# inside an excluded directory, so a negation below it never takes effect.
/artifacts/*
# ...except the trained model the hosted site actually runs. /metrics loads this
# booster in-process to score a real transaction on request, so it is part of
# the deployed application, not a local build product.
!/artifacts/graph_model.json
!/artifacts/graph_meta.json
# ...and the gateway model, which scores live payments at authorization.
!/artifacts/gateway_model.json
!/artifacts/gateway_meta.json

# ---- Python artifacts ----
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# ---- Notebooks ----
.ipynb_checkpoints/

# ---- OS junk ----
.DS_Store
