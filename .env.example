# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# The app fails loudly at startup if a required variable is missing.

# Required for Phase 4 (LLM risk-brief generation). Get one at:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: only needed if you use the convenience Kaggle download script.
# Preferred mechanism is the standard ~/.kaggle/kaggle.json file instead.
KAGGLE_USERNAME=
KAGGLE_KEY=
