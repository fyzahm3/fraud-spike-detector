# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# The app fails loudly at startup if a required variable is missing.

# Required for Phase 4 (LLM risk-brief generation). Get one at:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: only needed if you use the convenience Kaggle download script.
# Preferred mechanism is the standard ~/.kaggle/kaggle.json file instead.
KAGGLE_USERNAME=
KAGGLE_KEY=

# ---- Hosted demo dashboard (Session 2 / deployment) ----
# HTTP basic auth for the public demo instance. Auth is ENABLED only when both
# are set and non-empty; leave them blank locally to run without a login prompt.
# Set the real values in the hosting platform's environment UI. NEVER commit them.
DEMO_USER=
DEMO_PASSWORD=

# Serve the committed demo snapshot (data/demo_review_queue.db) instead of
# results/review_queue.db. Set to 1 on the hosted instance.
DEMO_MODE=

# Optional: reject POST /api/resolve with 403. Off by default so the demo's
# resolve buttons work in the pitch video.
READ_ONLY=

# Optional: explicit queue database path; overrides DEMO_MODE when set.
REVIEW_DB_PATH=

# Injected by most hosting platforms. Locally, `python app.py --port` wins.
PORT=
